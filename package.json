{
  "name": "pastestack",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a stack of clipboard images into a LinkedIn post.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "test:live": "node scripts/live-test.mjs",
    "check": "npm run typecheck && npm test",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "7.0.2"
  }
}
