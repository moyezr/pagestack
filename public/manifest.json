{
  "manifest_version": 3,
  "name": "PasteStack",
  "version": "0.2.0",
  "description": "Paste images into LinkedIn posts automatically. Keep writing, or switch to manual image review.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "action": { "default_title": "PasteStack settings", "default_popup": "popup.html" },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}
