{
  "manifest_version": 3,
  "name": "PasteStack",
  "version": "0.1.0",
  "description": "Paste clipboard images into one LinkedIn image stack. Review, then add them to your post together.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [{
    "matches": ["https://www.linkedin.com/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}
